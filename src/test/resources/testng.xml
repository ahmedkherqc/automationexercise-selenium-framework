<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AutomationExercise Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryTransformer"/>
    </listeners>
    <test name="AutomationExercise Tests">
        <packages>
            <package name="tests"/>
        </packages>
    </test>
</suite>
